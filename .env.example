# ============================================================
# Environment variable reference — copy to .env for local dev.
# On Render, add each variable in the dashboard Environment tab.
# ============================================================

# --- Site identity ---
SITE_NAME=Clare's Life Celebrations
SITE_TAGLINE=For Moments That Matter
SITE_CONTACT_EMAIL=clarebruntoncelebrant@gmail.com
SITE_PHONE_NUMBER=07885 428304
SITE_INSTAGRAM_URL=https://www.instagram.com/clareslifecelebrations/
SITE_BASE_URL=https://www.clarebruntonlifeceremonies.com

# --- Email sending (SMTP) ---
# On Render free services, prefer Resend because outbound SMTP ports are blocked.
SITE_FROM_EMAIL=
INQUIRY_NOTIFICATION_EMAIL=clarebruntoncelebrant@gmail.com
REVIEWS_NOTIFICATION_EMAIL=clarebruntoncelebrant@gmail.com
INQUIRY_FALLBACK_DIRECTORY=data/inquiries
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=clarebruntoncelebrant@gmail.com
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_CONNECTION_TIMEOUT=5000
SPRING_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_SMTP_WRITE_TIMEOUT=5000

# --- Local aggregate visit counter ---
ANALYTICS_STORAGE_DIRECTORY=data/analytics

# --- Review admin login ---
REVIEWS_ADMIN_USERNAME=
REVIEWS_ADMIN_PASSWORD=

# --- Spring settings ---
THYMELEAF_CACHE=true
